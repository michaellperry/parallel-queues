{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Billing": {
    "StorageFilePath": "/data/billing.json"
  },
  "PaymentService": {
    "BaseUrl": "http://simulated-payments:80/",
    "Resilience": {
      "TimeoutSeconds": 3,
      "MaxRetryAttempts": 5,
      "InitialBackoffSeconds": 0.5,
      "BackoffMultiplier": 1.5,
      "JitterFactor": 0.1
    }
  }
}
